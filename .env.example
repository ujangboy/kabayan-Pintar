# ============================================================
# Kabayan Pintar — Environment Variables (CONTOH / TEMPLATE)
# ============================================================
# File ini di-commit ke repo (aman, TIDAK berisi nilai rahasia).
# Salin menjadi .env dan ISI dengan nilai asli ANDA:
#     cp .env.example .env
# Lalu edit .env dan masukkan Groq API Key Anda.
#
# PENTING: .env sudah di-ignore oleh .gitignore; template ini dikecualikan.
# JANGAN pernah mengisi nilai nyata di file ini atau di commit.
# ------------------------------------------------------------

# Groq API Key — ambil dari https://console.groq.com/keys
# Format harus: gsk_<40+ karakter alfanumerik>
# Ganti placeholder di bawah dengan key asli HANYA di file .env (bukan di sini).
GROQ_API_KEY=<isi-groq-api-key-anda-di-sini>

# Model default Groq. Override jika akun Anda punya akses model lain.
# Lihat daftar model: https://console.groq.com/docs/models
# Default di app/config.py adalah openai/gpt-oss-20b (ringan, respons bersih tanpa blok).
GROQ_MODEL=openai/gpt-oss-20b

# Opsional — model untuk analisis gambar/vision (default: qwen/qwen3.8-27b).
# GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Opsional — batas pemakaian AI harian (default: 8000).
# GROQ_DAILY_LIMIT=8000

# Opsional — origin frontend yang diizinkan CORS, pisahkan dengan koma.
# Kosongkan untuk default lokal (localhost/127.0.0.1 port 5173 & 8000).
# CORS_ORIGINS=http://localhost:5173,https://kabayan.example.com

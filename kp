#!/usr/bin/env bash
# kp — Kabayan Pintar launcher (modular)
# Penggunaan:
#   chmod +x kp
#   ./kp              # jalankan aplikasi
#   ./kp --install    # instalasi core saja
#   ./kp --fresh      # backup .env + storage, lalu install fresh
#   ./kp feature rag  # pasang extra RAG
#   ./kp feature all  # pasang semua extra
set -euo pipefail

# Resolve symlink (~/.local/bin/kp) ke file asli di folder proyek.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  TARGET="$(readlink "$SOURCE")"
  case "$TARGET" in
    /*) SOURCE="$TARGET" ;;
    *) SOURCE="$(cd "$(dirname "$SOURCE")" && pwd)/$TARGET" ;;
  esac
done
DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
cd "$DIR"

# Aktifkan venv jika ada
if [ -f ".venv/bin/activate" ]; then
  # shellcheck disable=SC1091
  . .venv/bin/activate
fi

cmd_install() {
  bash scripts/install.sh core
}

cmd_fresh() {
  bash scripts/install.sh --fresh
}

cmd_feature() {
  local feature="${1:-}"
  bash scripts/install.sh feature "$feature"
}

cmd_start() {
  if [ ! -d ".venv" ]; then
    echo "[!] Belum diinstall. Jalankan: ./kp --install"
    exit 1
  fi

  echo "==> Kabayan Pintar sedang berjalan..."
  echo "    Backend : http://127.0.0.1:8000"
  echo "    Tekan Ctrl+C untuk berhenti."
  echo ""

  # Production: frontend dist disajikan via FastAPI
  if [ -d "frontend/dist" ]; then
    echo "    Mode: production (frontend dist via FastAPI, port 8000)"
    if command -v uvicorn >/dev/null 2>&1; then
      exec uvicorn app.main:app --host 127.0.0.1 --port 8000
    else
      exec python -m uvicorn app.main:app --host 127.0.0.1 --port 8000
    fi
  fi

  # Development: frontend via Vite dev server
  if [ -d "frontend/node_modules" ]; then
    echo "    Mode: development (frontend via Vite, port 5173)"
    (cd frontend && npm run dev:all)
  else
    echo "    Mode: backend saja (frontend belum di-build)"
    if command -v uvicorn >/dev/null 2>&1; then
      exec uvicorn app.main:app --host 127.0.0.1 --port 8000
    else
      exec python -m uvicorn app.main:app --host 127.0.0.1 --port 8000
    fi
  fi
}

case "${1:-}" in
  --install|install) cmd_install ;;
  --fresh|fresh) cmd_fresh ;;
  feature) shift || true; cmd_feature "${1:-}" ;;
  ""|run|start) cmd_start ;;
  *) echo "Penggunaan: ./kp [--install|--fresh|feature <rag|documents|media|all>|start]" ;;
esac
